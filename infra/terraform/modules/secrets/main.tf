# Spec 01 secrets: Secrets Manager entries for the database, the Anthropic key, the YouTube key
# and the session secret. No secret value ever appears in Terraform state:
# - API keys are created empty and set out of band (`aws secretsmanager put-secret-value`).
# - Database login and session passwords are generated by an ephemeral resource and written
#   through write-only attributes, so Terraform never stores them.
# - The RDS master password is owned by RDS itself (see the database module).

terraform {
  required_providers {
    aws = {
      source = "hashicorp/aws"
    }
    random = {
      source = "hashicorp/random"
    }
  }
}

variable "name" {
  description = "Name prefix, also the secret path prefix (for example dg-v1 gives dg-v1/...)."
  type        = string
}

variable "recovery_window_in_days" {
  type    = number
  default = 7
}

variable "rotation_version" {
  description = "Increment to generate and write new generated passwords. Existing logins must then be updated with `dg db create-login`."
  type        = number
  default     = 1
}

locals {
  # Set by a person out of band.
  external = {
    anthropic_api_key = "Claude API key"
    youtube_api_key   = "YouTube Data API key"
  }
  # Generated here, never stored in state. Database logins are the NOLOGIN group roles from
  # Spec 02 plus a login role that inherits from each.
  generated = {
    session_secret       = "Key that signs session cookies"
    db_dg_owner_login    = "Password of the dg_owner_login database role (migrations)"
    db_dg_web_login      = "Password of the dg_web_login database role (web service)"
    db_dg_pipeline_login = "Password of the dg_pipeline_login database role (batch host and CLI)"
  }
}

resource "aws_secretsmanager_secret" "external" {
  for_each                = local.external
  name                    = "${var.name}/${each.key}"
  description             = each.value
  recovery_window_in_days = var.recovery_window_in_days
}

resource "aws_secretsmanager_secret" "generated" {
  for_each                = local.generated
  name                    = "${var.name}/${each.key}"
  description             = each.value
  recovery_window_in_days = var.recovery_window_in_days
}

ephemeral "random_password" "generated" {
  for_each = local.generated
  length   = 40
  # URL-safe characters only, so a password can sit in a connection string without escaping.
  special = false
}

resource "aws_secretsmanager_secret_version" "generated" {
  for_each                 = local.generated
  secret_id                = aws_secretsmanager_secret.generated[each.key].id
  secret_string_wo         = ephemeral.random_password.generated[each.key].result
  secret_string_wo_version = var.rotation_version
}

output "arns" {
  description = "Secret ARNs by key."
  value = merge(
    { for k, s in aws_secretsmanager_secret.external : k => s.arn },
    { for k, s in aws_secretsmanager_secret.generated : k => s.arn },
  )
}
