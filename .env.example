# Every configuration key from Spec 01, with a safe local value.
# Copy to .env for local development. Never put real secrets in this file.

# One of dev, staging, prod. In prod the loader refuses debug and trace logging.
WT_ENV=dev

# Postgres connection for the application role. Outside dev, add sslmode=require.
DATABASE_URL=postgres://wt:wt@localhost:5432/wt

# Connection for the analyst role, used only by `wt report`. Optional.
DATABASE_URL_ANALYST=

# Web listen address.
WT_BIND=127.0.0.1:8080

# Key that signs session cookies. Required outside dev.
WT_SESSION_SECRET=

# The only place audio or video may exist.
WT_SCRATCH_DIR=./scratch

# S3 bucket for transcript JSON and the glossary. Unset means a local directory under ./data.
WT_TRANSCRIPT_BUCKET=

# Directory holding the exported ONNX models and tokenizers.
WT_MODEL_DIR=./models
WT_EMBED_MODEL=bge-m3-int8
WT_RERANK_MODEL=bge-reranker-v2-m3-int8

# Model identifier sent to the Claude API. Required for LLM stages only.
WT_LLM_MODEL=

# API credential. Secret: leave empty here.
ANTHROPIC_API_KEY=

# Must be true before any call carries real transcript text.
WT_LLM_REAL_DATA_OK=false

# Key for the YouTube Data API. Secret: leave empty here.
YOUTUBE_API_KEY=

# Enables the yt-dlp fetch mode. See Spec 03.
WT_ALLOW_THIRD_PARTY_FETCH=false

# Base URL of the diarization sidecar.
WT_DIARIZE_URL=http://127.0.0.1:8090

# Path to the whisper large-v3 model file for ASR.
WT_WHISPER_MODEL=

# The site's own donation page, shown separately in the dana panel.
WT_SITE_DANA_URL=

# Log filter. Logs are JSON in non-dev environments.
WT_LOG=info
