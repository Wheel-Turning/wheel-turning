# Every configuration key from Spec 01, with a safe local value.
# Copy to .env for local development. Never put real secrets in this file.

# One of dev, staging, prod. In prod the loader refuses debug and trace logging.
WT_ENV=dev

# Postgres connection for the application role. Outside dev, add sslmode=require.
DATABASE_URL=postgres://wt:wt@localhost:5432/wt

# Connection for the analyst role, used only by `wt report`. Optional.
DATABASE_URL_ANALYST=

# The name the database holds in database_identity (Spec 11, PB1.1): rds-v1 on RDS, pc on the
# PC. `wt worker`, `wt pipeline`, the rights commands and `wt takedown` refuse a database named
# otherwise. Required by those commands when WT_ENV=prod; empty skips the check in dev.
WT_DATABASE_NAME=

# Database connection from parts, used only when DATABASE_URL is unset and WT_DB_HOST is set,
# so a deployed password never sits in a stored connection string. Leave empty in dev.
# WT_DB_PORT defaults to 5432 and WT_DB_NAME to wt. WT_DB_PASSWORD is a secret.
WT_DB_HOST=
WT_DB_PORT=
WT_DB_NAME=
WT_DB_USER=
WT_DB_PASSWORD=

# The name the target database records in database_identity (rds-v1 or pc). The worker, the
# pipeline, rights commands and wt takedown refuse a database whose recorded name differs.
# Required in prod for those commands. See Spec 11, PB1.1.
WT_DATABASE_NAME=

# Web listen address.
WT_BIND=127.0.0.1:8080

# Key that signs session cookies. Required outside dev.
WT_SESSION_SECRET=

# The only place audio or video may exist.
WT_SCRATCH_DIR=./data/scratch

# PDF tools for `wt text import` and `wt text proof` (Spec 08, PDFs and OCR): poppler's bin
# directory and Tesseract's program, when they are not on the PATH. On Windows, Git's
# /mingw64/bin holds xpdf's pdftotext, which lacks -bbox-layout, so name poppler's directory.
# A PDF import also needs the English word list named by [texts] word_list in
# config/pipeline.toml, which on Windows must be set to a file you provide.
WT_POPPLER_BIN=
WT_TESSERACT=

# Directory holding retrieval.toml, common_words.txt, llm_prices.toml, sensitive.toml and
# sensitive_exemplars.toml for the web server and wt eval.
WT_CONFIG_DIR=config

# S3 bucket for transcript JSON and the glossary. Unset means a local directory under ./data.
WT_TRANSCRIPT_BUCKET=

# Directory holding the exported ONNX models and tokenizers.
WT_MODEL_DIR=./models
WT_EMBED_MODEL=bge-m3-int8
WT_RERANK_MODEL=bge-reranker-v2-m3-int8
# The ONNX Runtime library, 1.22 or newer. Unset means ORT_DYLIB_PATH or the system search path.
# scripts/export_models.py prints the path of the one it installs.
WT_ORT_DYLIB=
# The model license record. A stage refuses a model it does not list with a revision.
WT_MODEL_LICENSES=docs/model-licenses.md

# Model identifier sent to the Claude API. Required for LLM stages only.
WT_LLM_MODEL=

# Per-stage models, one for each llm_usage.stage. Each one falls back to WT_LLM_MODEL when
# empty. See Specs 04 and 11 (PB2.0). EXTRACT also sets window labeling (classify) and the
# student-question edit (question); TRIAGE is the sensitive-question gate (sensitive).
WT_LLM_MODEL_EXTRACT=
WT_LLM_MODEL_SYNTH=
WT_LLM_MODEL_VERIFY=
WT_LLM_MODEL_VISION=
WT_LLM_MODEL_TRIAGE=
WT_LLM_MODEL_EXCERPT=
WT_LLM_MODEL_RANK=

# Monthly spending cap for language model calls, in US dollars.
WT_LLM_MONTHLY_CAP_USD=25

# API credential. Secret: leave empty here.
ANTHROPIC_API_KEY=

# The Claude Console workspace to bill, for an API key that is not scoped to one. Empty for a
# workspace-scoped key.
ANTHROPIC_WORKSPACE_ID=

# Must be true before any call carries real transcript text.
WT_LLM_REAL_DATA_OK=false

# Key for the YouTube Data API. Secret: leave empty here.
YOUTUBE_API_KEY=

# OAuth refresh token for caption download in owner_api mode. Secret: leave empty here.
YOUTUBE_OAUTH_REFRESH_TOKEN=

# Vimeo API tokens, one per sangha's Vimeo account, each named by its source's token_env in
# config/sources.toml (scopes public, private, video_files). Empty means discovery reads the
# public talks page and Vimeo talks without a podcast match wait as no_media. Secret: leave
# empty here.
WT_SSZ_VIMEO_ACCESS_TOKEN=

# Enables the yt-dlp fetch mode. See Spec 03.
WT_ALLOW_THIRD_PARTY_FETCH=false

# Base URL of the diarization sidecar.
WT_DIARIZE_URL=http://127.0.0.1:8090

# Hugging Face token for the pyannote model, read by the diarization sidecar. Secret: leave empty here.
HF_TOKEN=

# Path to the whisper large-v3 model file for ASR.
WT_WHISPER_MODEL=

# Path to whisper.cpp's whisper-cli built for this machine, such as the Vulkan build the
# benchmark measured. The worker runs it as a subprocess. See Spec 04.
WT_WHISPER_CLI=

# Set to 1 on the transcription worker: whisper.cpp's Vulkan backend reads it, not the loader.
# Without it Vulkan produces garbage on the Arc 140V. See Spec 04.
GGML_VK_DISABLE_COOPMAT=1

# The site's own donation page, shown separately in the dana panel.
WT_SITE_DANA_URL=

# SNS topic for alerts to the owner (PB4.2). Empty logs them as warnings instead. `wt alerts test`
# publishes one message to it.
WT_ALERT_TOPIC_ARN=

# Who runs the site, as About names them ("run by <name>, an individual"). Empty says "an individual".
WT_OWNER_NAME=

# true behind the load balancer: the public forms' rate limit counts the last X-Forwarded-For
# address. Leave false when the server faces clients directly, since that header can be forged.
WT_TRUST_FORWARDED_FOR=false

# Question-keeping mode for new testers: share or count_only. Use count_only before any public launch.
WT_PRIVACY_DEFAULT=share

# Days a kept question's text is stored, and hours a count-only question is kept before deletion.
WT_QUERY_RETENTION_DAYS=180
WT_COUNT_ONLY_TTL_HOURS=24

# Log filter. Logs are JSON in non-dev environments.
WT_LOG=info

# Removal requests from /rights are confirmed by an emailed link (Spec 08). WT_MAIL_FROM is the
# SES sender, such as rights@wheelturning.org; WT_PUBLIC_URL is the site's address for the link,
# such as https://app.wheelturning.org. Set both or neither: one without the other stops
# startup. The web server refuses to start in prod without both. Without them in dev the form
# refuses requests.
WT_MAIL_FROM=
WT_PUBLIC_URL=
